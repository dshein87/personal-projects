# Room Parent Agent - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit the .env file to git

# ============================================================================
# NOTIFICATION SETTINGS
# ============================================================================
NOTIFICATION_EMAIL=your-email@example.com

# ============================================================================
# GOOGLE DRIVE & SHEETS
# ============================================================================
# Google Sheets ID for Room Parent tracking
# Extract from URL: https://docs.google.com/spreadsheets/d/{SHEET_ID}/edit
GOOGLE_SHEET_ID=your-sheet-id-here

# Google Drive folder ID for class communications
# Extract from URL: https://drive.google.com/drive/folders/{FOLDER_ID}
GOOGLE_DRIVE_FOLDER_ID=your-folder-id-here

# ============================================================================
# SCHOOL COMMUNICATION FILTERS
# ============================================================================
# Email addresses to filter for class communications (comma-separated)
# These are typically public school contact emails
SCHOOL_COMM_EMAILS=communications@example-school.org,teacher@example-school.org

# Parent distribution list email
PARENT_LIST_EMAIL=parents-class@example-school.org

# ============================================================================
# N8N WORKFLOW SETTINGS
# ============================================================================
# n8n Cloud workflow ID (if using n8n Cloud)
N8N_WORKFLOW_ID=your-workflow-id-here

# n8n instance URL (if self-hosted)
N8N_BASE_URL=https://your-n8n-instance.com

# ============================================================================
# HMAC SECRET FOR APPROVAL WEBHOOKS
# ============================================================================
# Generate with: openssl rand -hex 32
HMAC_SECRET=your-hmac-secret-here

# ============================================================================
# GITHUB REPOSITORY
# ============================================================================
# Your GitHub username and repo for fetching prompts
GITHUB_USER=your-github-username
GITHUB_REPO=your-repo-name
GITHUB_BRANCH=main
