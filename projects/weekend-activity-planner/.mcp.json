{
  "mcpServers": {
    "supabase": {
      "command": "npx",
      "args": [
        "-y",
        "@supabase/mcp-server-supabase@latest",
        "--project-ref=ohdmrfyyavlkoflbbjsd",
        "--read-only",
        "--features=database,docs"
      ]
    },
    "food-finder": {
      "command": "node",
      "args": ["mcp-servers/food-finder/dist/index.js"]
    },
    "n8n-builder": {
      "command": "npx",
      "args": ["-y", "mcp-n8n-builder"],
      "env": {
        "N8N_HOST": "${N8N_HOST}",
        "N8N_API_KEY": "${N8N_API_KEY}",
        "OUTPUT_VERBOSITY": "concise"
      }
    }
  }
}
