# Weekend Activity Planner - Environment Variables Template
# Copy this file to .env and fill in your actual values
# NEVER commit .env to git!

# ============================================
# Anthropic (Claude AI)
# ============================================
# Get API key from: https://console.anthropic.com
# Used for: n8n AI Agent workflows, MCP interactions
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Supabase (Database)
# ============================================
# Get from: https://supabase.com/dashboard/project/YOUR_PROJECT/settings/api
# Used for: PostgreSQL database, authentication
SUPABASE_URL=https://xxxxxxxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxx
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.xxxxxx

# Personal Access Token for Supabase MCP
# Generate at: https://supabase.com/dashboard/account/tokens
# Used for: Claude Code MCP server authentication (read-only database access)
SUPABASE_ACCESS_TOKEN=sbp_xxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Spotify (Music Integration)
# ============================================
# Create app at: https://developer.spotify.com/dashboard
# Used for: Concert discovery, music preferences
SPOTIFY_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPOTIFY_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SPOTIFY_REDIRECT_URI=http://localhost:8888/callback

# ============================================
# WhatsApp Cloud API (Meta)
# ============================================
# Setup at: https://developers.facebook.com/apps
# Used for: Bot messaging, notifications
WHATSAPP_API_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789012345
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token_here

# ============================================
# Google Calendar API
# ============================================
# Setup at: https://console.cloud.google.com
# Enable Calendar API and create OAuth credentials
# Used for: Calendar conflict checking
GOOGLE_CALENDAR_CLIENT_ID=xxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CALENDAR_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_CALENDAR_REFRESH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Weather API
# ============================================
# Option 1: OpenWeatherMap (requires key)
# Get from: https://openweathermap.org/api
OPENWEATHER_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Option 2: Weather.gov (no key needed, US only)
# Leave OPENWEATHER_API_KEY empty to use Weather.gov
WEATHER_API_PROVIDER=weather.gov

# ============================================
# Concert Discovery APIs
# ============================================
# Songkick
# Get from: https://www.songkick.com/developer
SONGKICK_API_KEY=xxxxxxxxxxxxxxxx

# Bandsintown
# Just needs an app ID (identifier, not secret)
BANDSINTOWN_APP_ID=weekend-activity-planner

# ============================================
# n8n (Automation Platform)
# ============================================
# Get from: n8n Cloud Settings > API
# Used for: Programmatic workflow creation via MCP n8n-builder

# n8n Cloud (recommended)
# Format: https://your-instance.app.n8n.cloud/api/v1
# Example: https://weekend-planner.app.n8n.cloud/api/v1
N8N_HOST=https://your-instance.app.n8n.cloud/api/v1
N8N_API_KEY=n8n_api_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# If self-hosting n8n
# N8N_HOST=http://localhost:5678/api/v1
# N8N_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ============================================
# Application Settings
# ============================================
# Home location for distance calculations
HOME_LOCATION=Oakland, CA 94611
HOME_LAT=37.8324
HOME_LON=-122.2128

# Distance preferences
MAX_DRIVE_TIME_MINUTES=90
COMFORT_DRIVE_TIME_MINUTES=30

# Timezone
TIMEZONE=America/Los_Angeles

# ============================================
# Dietary Restrictions
# ============================================
# Tracked in database, but can reference here
DIETARY_RESTRICTIONS_WIFE=celiac
DIETARY_RESTRICTIONS_DAUGHTER=sesame,cashew,flax

# ============================================
# Feature Flags (Optional)
# ============================================
# Enable/disable features during development
ENABLE_CONCERT_DISCOVERY=true
ENABLE_EVENT_SCRAPING=true
ENABLE_WHATSAPP_NOTIFICATIONS=true
ENABLE_WEEKLY_SUGGESTIONS=true

# ============================================
# Development Settings
# ============================================
# Set to 'development' or 'production'
NODE_ENV=development

# Logging level (debug, info, warn, error)
LOG_LEVEL=info

# Enable debug mode for MCP servers
DEBUG_MCP=false

# ============================================
# Database Connection (for direct SQL if needed)
# ============================================
# Supabase provides connection string in dashboard
# Format: postgresql://user:pass@host:port/db
# Only needed for direct database access outside Supabase client
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.xxxxxxxxxxxxx.supabase.co:5432/postgres

# ============================================
# Security Notes
# ============================================
# 1. NEVER commit this file with real values!
# 2. Keep service role keys secret (server-side only)
# 3. Rotate keys if accidentally exposed
# 4. Use different keys for dev/prod environments
# 5. Limit API key permissions to minimum needed
